# P19 - LINGUA AI Configuration

# LLM Configuration
# Provide an API key from OpenAI, Groq, or any OpenAI-compatible provider
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional custom base URL (e.g. https://api.groq.com/openai/v1 or https://generativelanguage.googleapis.com/v1beta/openai/ or http://localhost:11434/v1)
LLM_BASE_URL=

# Hugging Face Models (Local / Auto-downloaded)
NMT_MODEL_HI=Helsinki-NLP/opus-mt-en-hi
NMT_MODEL_MR=Helsinki-NLP/opus-mt-en-mr
BLIP_MODEL=Salesforce/blip-image-captioning-base

# Device ("auto", "cuda", "mps", "cpu")
DEVICE=auto

